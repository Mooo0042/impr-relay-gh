# "discord" or "local"
STORAGE=discord

# Required for STORAGE=discord (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef

# Public base URL of this server. Keep the trailing slash.
PUBLIC_URL=https://relay.example.com/

PORT=3009
RELAY_NAME=My IMPR Relay

# Bytes. Must not exceed your Discord server's upload limit (8 MiB is safe).
MAX_FILE_SIZE=8388608

# Uploads per player UUID per hour (per IP: 5x this)
RATE_LIMIT_PER_HOUR=20

# Delete files after N days (0 = keep forever)
RETENTION_DAYS=0

# Comma-separated player UUIDs; empty = anyone can upload
ALLOWED_UUIDS=

# Set to 1 when running behind nginx/Caddy so X-Forwarded-* is trusted
TRUST_PROXY=0

DATA_DIR=./data
